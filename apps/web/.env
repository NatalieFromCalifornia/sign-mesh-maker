# Firebase web config for the deployed app.
#
# Committed on purpose. These are not secrets: Firebase compiles them into the
# client bundle, so they are already public to anyone who loads the site. Access
# is enforced by firestore.rules and the Auth authorized-domains list, not by
# keeping these values hidden.
#
# They live here rather than in the Cloudflare dashboard because this Worker
# serves static assets only, which blocks the dashboard's variable settings —
# and because a build step that lives only in a dashboard is invisible, which is
# exactly what blanked production once already.
#
# .env.local is still gitignored and still wins over this file locally, so any
# per-developer overrides keep working.

VITE_FIREBASE_API_KEY=AIzaSyCqNLIkqAeXjnS16H6q_QgDLgCmZgeDOMQ
VITE_FIREBASE_AUTH_DOMAIN=sign-mesh-maker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sign-mesh-maker
VITE_FIREBASE_MESSAGING_SENDER_ID=786272648624
VITE_FIREBASE_APP_ID=1:786272648624:web:4d110e3b8fdae4e3ee6a75
