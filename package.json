{
  "name": "sign-mesh-maker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "deploy": "wrangler deploy",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:rules && npm run test:e2e",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project sign-mesh-maker-rules-test \"node rules-tests/firestore.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.0.0"
  }
}
